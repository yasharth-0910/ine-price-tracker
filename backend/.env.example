# Backend env. Copy to .env and fill in. Boot fails loudly if a required var is missing.

# Required. Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Use the connection-pooler URI for a serverless/free host.
DATABASE_URL=postgres://user:password@host:6543/postgres

# Optional. Defaults shown.
PORT=4000
LOG_LEVEL=info
